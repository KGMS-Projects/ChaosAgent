# Copy this file to .env and fill in your values, then `export $(cat .env | xargs)`
# or use a tool like python-dotenv / direnv to load it before running main.py.

# Required for live mode (real Claude API calls from Adversary/Remediation/Sentinel)
ANTHROPIC_API_KEY=sk-ant-api03-YOUR-KEY-HERE

# Model selection (defaults match src/config.py if unset)
CHAOS_REASONING_MODEL=claude-sonnet-5
CHAOS_MONITOR_MODEL=claude-haiku-4-5-20251001

# Kubernetes target
# For minikube: CHAOS_KUBE_CONTEXT=minikube
# For GKE: CHAOS_KUBE_CONTEXT=gke_PROJECT_ZONE_CLUSTER
CHAOS_NAMESPACE=chaos-demo
CHAOS_KUBE_CONTEXT=minikube
# KUBECONFIG=/home/you/.kube/config   # usually not needed, defaults to ~/.kube/config

# Prometheus (point this at your kubectl port-forward, e.g.
#   kubectl -n chaos-demo port-forward svc/prometheus-server 9090:80
PROMETHEUS_URL=http://localhost:9090

# Metric naming scheme: auto / istio / app_native
# - "auto" (default): probes Prometheus and auto-detects
# - "istio": Online Boutique with Istio sidecar -> istio_requests_total
# - "app_native": app-level instrumentation -> http_requests_total
CHAOS_METRIC_SCHEME=auto

# Evaluation harness output location
CHAOS_RESULTS_DIR=./results
